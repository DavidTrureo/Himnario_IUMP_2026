rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Función para validar que el usuario sea el Administrador Oficial ──
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@himnario.com';
    }

    // ── Setlists (locales, solo compatibilidad migración) ──────────────────
    match /setlists/{docId} {
      allow read, write: if true;
    }

    // ── Sesiones de Culto en Vivo ──────────────────────────────────────────
    match /live_sessions/{sessionId} {
      // Cualquiera puede leer (participantes que abren el QR)
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;

      match /participants/{deviceId} {
        allow read, write: if true;
      }
    }

    // ── Himnos (Colecciones de la App) ─────────────────────────────────────
    match /iump/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /especiales/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coros/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /live_worship_rooms/{docId} {
      allow read, write: if true;
    }
    match /tv_rooms/{docId} {
      allow read, write: if true;
    }
    
    // ── Registro de dispositivos / instalaciones (solo lectura Admin) ───────
    function isValidDeviceInstall(deviceId) {
      let data = request.resource.data;
      return data.keys().hasAll(['deviceId', 'platform', 'appVersion', 'installStatus'])
        && data.keys().hasOnly([
          'deviceId', 'platform', 'appVersion', 'installStatus',
          'hasFcmToken', 'fcmToken', 'firstSeenAt', 'lastSeenAt', 'fcmUpdatedAt'
        ])
        && data.deviceId == deviceId
        && deviceId is string && deviceId.size() >= 6 && deviceId.size() <= 120
        && data.platform in ['android', 'ios', 'web', 'macos', 'windows', 'linux', 'other']
        && data.appVersion is string && data.appVersion.size() >= 1 && data.appVersion.size() <= 40
        && data.installStatus == 'active'
        && (!('hasFcmToken' in data) || data.hasFcmToken is bool)
        && (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 512));
    }

    match /device_installs/{deviceId} {
      allow read, delete: if isAdmin();
      allow create, update: if isValidDeviceInstall(deviceId);
    }

    // ── Sugerencias de Himnos ──────────────────────────────────────────────
    match /cantos_sugeridos/{docId} {
      // Cualquiera puede crear una sugerencia
      allow create: if true;
      // Solo el admin puede verlas, aprobarlas (actualizar) o rechazarlas (eliminar)
      allow read, update, delete: if isAdmin();
    }
  }
}
