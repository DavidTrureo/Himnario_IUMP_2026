rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Función para validar que el usuario sea el Administrador Oficial ──
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@himnario.com';
    }

    // ── Setlists (locales, solo compatibilidad migración) ──────────────────
    match /setlists/{docId} {
      allow read, write: if true;
    }

    // ── Sesiones de Culto en Vivo ──────────────────────────────────────────
    match /live_sessions/{sessionId} {
      // Cualquiera puede leer (participantes que abren el QR)
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;

      match /participants/{deviceId} {
        allow read, write: if true;
      }
    }

    // ── Himnos (Colecciones de la App) ─────────────────────────────────────
    match /iump/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /especiales/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coros/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /live_worship_rooms/{docId} {
      allow read, write: if true;
    }
    
    // ── Sugerencias de Himnos ──────────────────────────────────────────────
    match /cantos_sugeridos/{docId} {
      // Cualquiera puede crear una sugerencia
      allow create: if true;
      // Solo el admin puede verlas, aprobarlas (actualizar) o rechazarlas (eliminar)
      allow read, update, delete: if isAdmin();
    }
  }
}
