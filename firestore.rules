rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Función para validar que el usuario sea el Administrador Oficial ──
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@himnario.com';
    }

    // ── Setlists (locales, solo compatibilidad migración) ──────────────────
    match /setlists/{docId} {
      allow read, write: if true;
    }

    // ── Sesiones de Culto en Vivo ──────────────────────────────────────────
    match /live_sessions/{sessionId} {
      // Cualquiera puede leer (participantes que abren el QR)
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;

      match /participants/{deviceId} {
        allow read, write: if true;
      }
    }

    // ── Himnos (Colecciones de la App) ─────────────────────────────────────
    match /iump/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /especiales/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coros/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /live_worship_rooms/{docId} {
      allow read, write: if true;
    }
    match /tv_rooms/{docId} {
      allow read, write: if true;
    }
    
    // ── Registro de dispositivos / instalaciones (solo lectura Admin) ───────
    function isValidDeviceInstall(deviceId) {
      let data = request.resource.data;
      return data.keys().hasAll(['deviceId', 'platform', 'appVersion', 'installStatus'])
        && data.keys().hasOnly([
          'deviceId', 'platform', 'appVersion', 'installStatus',
          'hasFcmToken', 'fcmToken', 'firstSeenAt', 'lastSeenAt', 'fcmUpdatedAt'
        ])
        && data.deviceId == deviceId
        && deviceId is string && deviceId.size() >= 6 && deviceId.size() <= 120
        && data.platform in ['android', 'ios', 'web', 'macos', 'windows', 'linux', 'other']
        && data.appVersion is string && data.appVersion.size() >= 1 && data.appVersion.size() <= 40
        && data.installStatus == 'active'
        && (!('hasFcmToken' in data) || data.hasFcmToken is bool)
        && (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 512));
    }

    match /device_installs/{deviceId} {
      allow read, delete: if isAdmin();
      allow create, update: if isValidDeviceInstall(deviceId);
    }

    // ── Sugerencias de Himnos ──────────────────────────────────────────────
    // Assumed Data Model — Collection: cantos_sugeridos/{docId}
    // Document ID: Firestore auto-generated random ID (saved locally in client SharedPreferences)
    // Required on create:
    //   - title: string (1..200)
    //   - lyrics: string (1..20000)
    //   - collection: string in ['iump', 'especiales', 'coros']
    //   - requesterName: string (1..120)
    //   - requesterChurch: string (1..120)
    //   - status: string ('pending' on create; admin transitions to 'approved' | 'rejected')
    //   - timestamp: timestamp (must equal request.time on create; immutable)
    // Optional on create:
    //   - key: string (<=60)
    //   - beats: string (<=30)
    //   - timeSignature: string (<=30)
    //   - category: string (<=100)
    //   - type: string in ['new', 'correction', 'medley']
    //   - source: string in ['manual', 'scanner_ia']
    //   - targetHymnId: int or null
    //   - targetTitle: string (<=200) or null
    //   - targetCollection: string (<=40) or null
    //   - reason: string (<=500) or null
    // Admin-only review fields (forbidden on create, allowed only on admin update):
    //   - approvedAt: timestamp or null
    //   - reviewedAt: timestamp or null
    //   - publishedId: int or null
    //   - publishedCollection: string in ['iump', 'especiales', 'coros'] or null
    //   - publishedTitle: string (<=200) or null
    //   - rejectionReason: string (<=500) or null
    //   - editedByAdmin: bool or null
    //   - adminEditSummary: string (<=200) or null
    function isValidSuggestedHymnCreate() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'title', 'lyrics', 'collection', 'requesterName', 'requesterChurch',
          'status', 'timestamp'
        ])
        && data.keys().hasOnly([
          'title', 'lyrics', 'collection', 'requesterName', 'requesterChurch',
          'status', 'timestamp',
          'key', 'beats', 'timeSignature', 'category', 'type', 'source',
          'targetHymnId', 'targetTitle', 'targetCollection', 'reason'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.lyrics is string && data.lyrics.size() >= 1 && data.lyrics.size() <= 20000
        && data.collection in ['iump', 'especiales', 'coros']
        && data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 120
        && data.requesterChurch is string && data.requesterChurch.size() >= 1 && data.requesterChurch.size() <= 120
        && data.status == 'pending'
        && data.timestamp is timestamp && data.timestamp == request.time
        && (!('key' in data) || (data.key is string && data.key.size() <= 60))
        && (!('beats' in data) || (data.beats is string && data.beats.size() <= 30))
        && (!('timeSignature' in data) || (data.timeSignature is string && data.timeSignature.size() <= 30))
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('type' in data) || data.type in ['new', 'correction', 'medley'])
        && (!('source' in data) || data.source in ['manual', 'scanner_ia'])
        && (!('targetHymnId' in data) || data.targetHymnId == null || data.targetHymnId is int)
        && (!('targetTitle' in data) || data.targetTitle == null || (data.targetTitle is string && data.targetTitle.size() <= 200))
        && (!('targetCollection' in data) || data.targetCollection == null || (data.targetCollection is string && data.targetCollection.size() <= 40))
        && (!('reason' in data) || data.reason == null || (data.reason is string && data.reason.size() <= 500));
    }

    function isValidSuggestedHymnAdminUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'status', 'approvedAt', 'reviewedAt',
          'publishedId', 'publishedCollection', 'publishedTitle', 'rejectionReason',
          'editedByAdmin', 'adminEditSummary'
        ])
        && data.status in ['pending', 'approved', 'rejected']
        && (!('approvedAt' in data) || data.approvedAt == null || data.approvedAt is timestamp)
        && (!('reviewedAt' in data) || data.reviewedAt == null || data.reviewedAt is timestamp)
        && (!('publishedId' in data) || data.publishedId == null || data.publishedId is int)
        && (!('publishedCollection' in data) || data.publishedCollection == null || data.publishedCollection in ['iump', 'especiales', 'coros'])
        && (!('publishedTitle' in data) || data.publishedTitle == null || (data.publishedTitle is string && data.publishedTitle.size() <= 200))
        && (!('rejectionReason' in data) || data.rejectionReason == null || (data.rejectionReason is string && data.rejectionReason.size() <= 500))
        && (!('editedByAdmin' in data) || data.editedByAdmin == null || data.editedByAdmin is bool)
        && (!('adminEditSummary' in data) || data.adminEditSummary == null || (data.adminEditSummary is string && data.adminEditSummary.size() <= 200));
    }

    match /cantos_sugeridos/{docId} {
      // Un usuario que posee el docId aleatorio exacto puede consultar el estado de su
      // propia sugerencia (get), pero solo el admin puede listar o consultar la colección.
      allow get: if true;
      allow list: if isAdmin();
      // Cualquiera puede crear una sugerencia válida con estado inicial 'pending'
      allow create: if isValidSuggestedHymnCreate();
      // Solo el admin puede aprobar/rechazar (actualizar campos de revisión) o eliminar
      allow update: if isAdmin() && isValidSuggestedHymnAdminUpdate();
      allow delete: if isAdmin();
    }

    // ── Sincronización en la Nube de Usuario (user_sync) ────────────────────
    // Assumed Data Model — Collection: user_sync/{userId} y user_sync/{userId}/data/{docId}
    // Document ID: Firebase Auth UID del usuario (o subcolección data/{docId})
    // Reglas de acceso: Solo el usuario autenticado propietario (request.auth.uid == userId) o el Admin.
    // Campos permitidos en data:
    //   - favorites: list (<= 2000 elementos, strings con claves de cantos como 'iump-1', 'especiales-10')
    //   - setlists: list (<= 500 elementos, mapas u objetos con campos de repertorios de culto)
    //   - history: list (<= 300 elementos, mapas con cantos visualizados recientemente)
    //   - updatedAt: timestamp o int (timestamp de Firestore o millis Unix > 0)
    //   - devicePlatform: string opcional (1..50 caracteres)
    //   - email: string opcional (<= 254 caracteres) o null
    //   - userId: string opcional (debe coincidir con userId de la ruta si está presente)
    //   - uid: string opcional (debe coincidir con userId de la ruta si está presente)
    //   - createdAt: timestamp o int opcional (inmutable tras creación)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUserSyncOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    function isValidUserSyncData(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'favorites', 'setlists', 'history', 'updatedAt',
          'devicePlatform', 'email', 'userId', 'uid', 'createdAt'
        ])
        && (!('favorites' in data) || data.favorites == null || (data.favorites is list && data.favorites.size() <= 2000))
        && (!('setlists' in data) || data.setlists == null || (data.setlists is list && data.setlists.size() <= 500))
        && (!('history' in data) || data.history == null || (data.history is list && data.history.size() <= 300))
        && (!('updatedAt' in data) || data.updatedAt is timestamp || (data.updatedAt is int && data.updatedAt > 0))
        && (!('devicePlatform' in data) || data.devicePlatform == null || (data.devicePlatform is string && data.devicePlatform.size() >= 1 && data.devicePlatform.size() <= 50))
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 254))
        && (!('userId' in data) || data.userId == userId)
        && (!('uid' in data) || data.uid == userId)
        && (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is int && data.createdAt > 0));
    }

    function isValidUserSyncUpdate(userId) {
      let data = request.resource.data;
      let prev = resource.data;
      return isValidUserSyncData(userId)
        && (!('createdAt' in prev) || !('createdAt' in data) || data.createdAt == prev.createdAt)
        && (!('userId' in prev) || !('userId' in data) || data.userId == prev.userId)
        && (!('uid' in prev) || !('uid' in data) || data.uid == prev.uid);
    }

    match /user_sync/{userId} {
      allow read, delete: if isUserSyncOwner(userId);
      allow create: if isUserSyncOwner(userId) && isValidUserSyncData(userId);
      allow update: if isUserSyncOwner(userId) && isValidUserSyncUpdate(userId);

      match /data/{docId} {
        allow read, delete: if isUserSyncOwner(userId);
        allow create: if isUserSyncOwner(userId) && isValidUserSyncData(userId);
        allow update: if isUserSyncOwner(userId) && isValidUserSyncUpdate(userId);
      }
    }
  }
}
